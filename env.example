# Copia questo file in .env e compila con le tue credenziali reali.
# NON committare mai il file .env (è già escluso da .gitignore).

# Token del bot Telegram, ottenuto da @BotFather (unico bot per tutti gli istituti)
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat Telegram di ciascun istituto: id numerico (es. -1001234567890) oppure
# @handle per gruppi/canali pubblici. Il bot deve essere membro del gruppo
# (amministratore se è un canale).
#
# IC "E. Toti" Lentate — se assente vale ancora il vecchio TELEGRAM_CHAT
TELEGRAM_CHAT_ICTOTI=123456789
# IC Via De Gasperi Seveso — se assente usa @icdegasperisevesonews
TELEGRAM_CHAT_DEGASPERI=@icdegasperisevesonews

# Percorso del file di stato (default già corretto per Docker, di solito non va toccato)
STATE_FILE=state/last_seen.json

# Modalità sviluppo: non richiede credenziali e non invia messaggi Telegram.
# Il monitor funziona normalmente e aggiorna STATE_FILE; gli invii sono simulati nel log.
DEBUG_MODE=false
