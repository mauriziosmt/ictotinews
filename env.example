# Copia questo file in .env e compila con le tue credenziali reali.
# NON committare mai il file .env (è già escluso da .gitignore).

# Token del bot Telegram, ottenuto da @BotFather
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID della chat o canale Telegram a cui inviare le notifiche
# (può essere il tuo chat_id personale, oppure l'id di un canale tipo -1001234567890)
TELEGRAM_CHAT=123456789

# Percorso del file di stato (default già corretto per Docker, di solito non va toccato)
STATE_FILE=state/last_seen.json
